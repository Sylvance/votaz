{% extends 'base.html.twig' %}

{% block title %}Polls · Admin · {{ institution_name }}{% endblock %}

{% block body %}
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;">
        <h1>Polls &amp; surveys</h1>
        <a class="btn" href="{{ path('admin_poll_new') }}">New poll</a>
    </div>

    <div class="panel mt">
        <table>
            <thead><tr><th>Title</th><th>Type</th><th>Opens</th><th>Closes</th><th>Actions</th></tr></thead>
            <tbody>
            {% for poll in polls %}
                <tr>
                    <td><a href="{{ path('admin_poll_show', {id: poll.id}) }}">{{ poll.title }}</a></td>
                    <td><span class="badge {{ poll.isSurvey ? 'amber' : 'muted' }}">{{ poll.isSurvey ? 'Survey' : 'Poll' }}</span></td>
                    <td class="small">{{ poll.startsAt ? poll.startsAt|date('d M Y') : '—' }}</td>
                    <td class="small">{{ poll.endsAt ? poll.endsAt|date('d M Y') : '—' }}</td>
                    <td><a class="btn secondary small" href="{{ path('admin_poll_edit', {id: poll.id}) }}">Edit</a></td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="muted">No polls yet.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}