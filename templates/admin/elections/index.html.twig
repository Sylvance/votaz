{% extends 'base.html.twig' %}

{% block title %}Elections · Admin · {{ institution_name }}{% endblock %}

{% block body %}
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;">
        <h1>Elections</h1>
        <a class="btn" href="{{ path('admin_election_new') }}">New election</a>
    </div>

    <div class="panel mt">
        <table>
            <thead><tr><th>Name</th><th>Type</th><th>Status</th><th>Registration window</th><th>Polling day</th><th>Actions</th></tr></thead>
            <tbody>
            {% for election in elections %}
                <tr>
                    <td><a href="{{ path('admin_election_show', {id: election.id}) }}">{{ election.name }}</a></td>
                    <td><span class="badge muted">{{ election.type.label }}</span></td>
                    <td><span class="badge {{ election.status.value == 'voting' ? 'green' : (election.status.value == 'results_published' ? 'muted' : 'amber') }}">{{ election.status.label }}</span></td>
                    <td class="small">{% if election.registrationStartAt %}{{ election.registrationStartAt|date('d M') }} – {{ election.registrationEndAt|date('d M Y') }}{% else %}—{% endif %}</td>
                    <td class="small">{{ election.votingStartAt|date('d M Y') }}</td>
                    <td><a class="btn secondary small" href="{{ path('admin_election_edit', {id: election.id}) }}">Edit</a></td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="muted">No elections yet.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}