<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Confirm your voter registration</title>
</head>
<body style="margin:0;padding:0;background:#f4f6fb;font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding:24px 12px;">
    <tr><td align="center">
        <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e5e7eb;">
            {% if type.value == 'registration_confirmation' %}
            <tr><td style="background:#1e3a8a;padding:20px 28px;color:#fff;">
                <h2 style="margin:0;font-size:18px;">Confirm your voter registration</h2>
                <p style="margin:4px 0 0;opacity:.9;font-size:13px;">{{ institution }}</p>
            </td></tr>
            {% else %}
            <tr><td style="background:#1e3a8a;padding:20px 28px;color:#fff;">
                <h2 style="margin:0;font-size:18px;">Your login code</h2>
                <p style="margin:4px 0 0;opacity:.9;font-size:13px;">{{ institution }}</p>
            </td></tr>
            {% endif %}
            <tr><td style="padding:28px;">
                <p>Hello {{ voter.firstName }},</p>
                <p>Use the six-digit code below to continue. It expires in 15 minutes.</p>
                <p style="font-size:32px;letter-spacing:10px;font-weight:800;color:#1d4ed8;margin:18px 0;">{{ code }}</p>
                <p>If you did not start this action, you can safely ignore this email.</p>
                <hr style="border:none;border-top:1px dashed #e5e7eb;margin:22px 0;">
                <p style="color:#6b7280;font-size:12px;">Your voter number is {{ voter.voterNumber }}.</p>
            </td></tr>
        </table>
    </td></tr>
</table>
</body>
</html>